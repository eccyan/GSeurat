{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Interactive music config (Phase 1)",
  "type": "object",
  "required": ["version", "sample_rate", "track_groups"],
  "properties": {
    "version":     { "type": "integer", "const": 2 },
    "sample_rate": { "type": "integer", "minimum": 1 },
    "track_groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/trackGroup" }
    }
  },
  "$defs": {
    "trackGroup": {
      "type": "object",
      "required": ["id", "name", "stems"],
      "properties": {
        "id":         { "type": "integer", "minimum": 1, "maximum": 63 },
        "name":       { "type": "string" },
        "loop_start": { "type": "integer", "minimum": 0, "default": 0 },
        "loop_end":   { "type": "integer", "minimum": 0, "default": 0 },
        "bpm":        { "type": "number",  "default": 0 },
        "markers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["frame"],
            "properties": {
              "frame": { "type": "integer", "minimum": 0 },
              "name":  { "type": "string" }
            }
          }
        },
        "stems": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["source"],
            "properties": {
              "source":         { "type": "string" },
              "initial_volume": { "type": "number", "default": 1.0 }
            }
          }
        }
      }
    }
  }
}
