#version 450

// Tile-bin Pass 3 (Scatter). Deterministic write of TileSortEntry into
// tile_entries[] using offsets computed by the count + scan passes.
//
// Each visible splat reads its precomputed exclusive prefix from
// per_splat_tile_offset[gid] and writes its (tx_max-tx_min+1) *
// (ty_max-ty_min+1) entries sequentially starting at that offset. The
// projection / culling math is intentionally identical to gs_tile_count.comp
// — any divergence breaks the count↔scatter invariant and corrupts the
// scan layout. Keep them in lockstep.
//
// This replaces the global atomicAdd in the previous implementation. The
// only remaining check is the per-write capacity bound: if a splat's
// computed offset exceeds max_entries, the write is dropped (matches the
// old behaviour where atomicAdd was free to overshoot capacity).

layout(local_size_x = 256) in;

struct ProjectedSplat {
    vec2 center;
    float depth;
    float radius;
    vec4 conic_opacity;
    vec4 color;
};

struct TileSortEntry {
    uint key;    // [31:16] = tile_id, [15:0] = depth_q
    uint index;
};

struct SortEntry {
    uint key;
    uint index;
};

layout(set = 0, binding = 0) readonly buffer ProjectedBuffer {
    ProjectedSplat projected[];
};

layout(set = 0, binding = 1) readonly buffer MergedSortBuffer {
    SortEntry merged_entries[];
};

layout(set = 0, binding = 2) readonly buffer CountsBuffer {
    uint static_count;
    uint dynamic_count;
    uint merged_visible_count;
};

layout(set = 0, binding = 4) readonly buffer PerSplatTileOffsetBuffer {
    uint per_splat_tile_offset[];
};

layout(set = 0, binding = 5) writeonly buffer TileSortBuffer {
    TileSortEntry tile_entries[];
};

layout(set = 0, binding = 6) uniform Uniforms {
    mat4 view;
    mat4 proj;
    mat4 inv_view;
    mat4 inv_proj;
    uvec4 params;
    vec4 shadow_box;
    vec4 cone_dir;
    vec4 cam_pos;
    vec4 effect_flags;
    vec4 light_params;
    vec4 touch_point;
    vec4 effect_params;
    vec4 effect_params2;
    vec4 point_light_params;
    vec4 actor_rotation;
    vec4 pl_pos_rad[8];
    vec4 pl_color[8];
    vec4 pl_dir_cone[8];
    vec4 pl_area[8];
    vec4 tile_sort_params;
};

layout(push_constant) uniform PushConstants {
    uint max_entries;
};

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint visible = static_count + dynamic_count;
    if (gid >= visible) return;

    SortEntry entry = merged_entries[gid];
    if (entry.key == 0xFFFFu) return;

    uint idx = entry.index;
    ProjectedSplat splat = projected[idx];

    if (splat.radius <= 0.0) return;

    vec2 c = splat.center;
    float r = splat.radius;
    uint tiles_x = uint(tile_sort_params.z);
    uint tiles_y = uint(tile_sort_params.w);

    int tx_min = max(0, int(floor((c.x - r) / 16.0)));
    int tx_max = min(int(tiles_x) - 1, int(floor((c.x + r) / 16.0)));
    int ty_min = max(0, int(floor((c.y - r) / 16.0)));
    int ty_max = min(int(tiles_y) - 1, int(floor((c.y + r) / 16.0)));

    if (tx_max < tx_min || ty_max < ty_min) return;

    float near_z = tile_sort_params.x;
    float far_z  = tile_sort_params.y;
    float t = clamp((splat.depth - near_z) / (far_z - near_z), 0.0, 1.0);
    uint depth_q = min(uint(t * 65535.0), 0xFFFEu);

    // Deterministic write base — computed by the count + exclusive-scan
    // passes. Each (ty, tx) iteration of the inner loop writes to the
    // next sequential slot starting here.
    uint write_offset = per_splat_tile_offset[gid];

    for (int ty = ty_min; ty <= ty_max; ty++) {
        for (int tx = tx_min; tx <= tx_max; tx++) {
            uint tile_id = uint(ty) * tiles_x + uint(tx);
            uint sort_key = (tile_id << 16u) | depth_q;
            if (write_offset < max_entries) {
                tile_entries[write_offset].key = sort_key;
                tile_entries[write_offset].index = idx;
            }
            write_offset++;
        }
    }
}
